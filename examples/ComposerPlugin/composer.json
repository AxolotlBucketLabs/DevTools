{
    "name": "devtools/example-composer-plugin",
    "description": "DevTools Composer preparation example",
    "type": "pocketmine-plugin",
    "license": "MIT",
    "require": {
        "devtools/example-composer-greeting": "^1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/composer-greeting",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "DevToolsExample\\ComposerPlugin\\": "src/"
        }
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
