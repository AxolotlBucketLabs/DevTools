{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AxolotlBucketLabs/DevTools/blob/main/docs/ecosystem.schema.json",
  "title": "DevTools ecosystem inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "scope",
    "devtools",
    "summary",
    "verified_repositories",
    "migrations"
  ],
  "properties": {
    "$schema": {
      "const": "./ecosystem.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checked_on",
        "description",
        "organizations",
        "include_archived",
        "repositories_inspected",
        "workflow_files_inspected",
        "counting_rule",
        "exclusions"
      ],
      "properties": {
        "checked_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "organizations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "include_archived": {
          "const": false
        },
        "repositories_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "workflow_files_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "counting_rule": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exclusion"
          }
        }
      }
    },
    "devtools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_version",
        "stable_commit",
        "reference_policy"
      ],
      "properties": {
        "stable_version": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+$"
        },
        "stable_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reference_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_repositories",
        "migrated_repositories",
        "total_repositories",
        "organization_totals"
      ],
      "properties": {
        "verified_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "migrated_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "total_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "organization_totals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/organizationTotal"
          }
        }
      }
    },
    "verified_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "migrations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "name",
        "url"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[^/\\s]+$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        }
      }
    },
    "organizationTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "verified",
        "migrated",
        "total"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "integer",
          "minimum": 0
        },
        "migrated": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
