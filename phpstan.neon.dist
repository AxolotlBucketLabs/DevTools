parameters:
    level: max
    phpVersion: 80400
    paths:
        - src
        - bin
        - tests
    excludePaths:
        analyseAndScan:
            - tests/Fixtures/PhpStanServer
            - tests/Fixtures/RuntimeSmoke/*.tpl.php
    tmpDir: .phpstan-cache
    reportUnmatchedIgnoredErrors: true
    checkMissingCallableSignature: true
