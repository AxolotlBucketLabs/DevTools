{
    "name": "axolotlbucketlabs/devtools",
    "description": "Folder loading, shared development virions and standalone plugin or virion PHAR tooling for Axolotl-PM",
    "keywords": [
        "pocketmine-mp",
        "plugin-development",
        "virion"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "homepage": "https://github.com/AxolotlBucketLabs/DevTools",
    "type": "pocketmine-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-phar": "*",
        "ext-zip": "*",
        "ext-yaml": "*",
        "nikic/php-parser": "^5.6"
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.51.1",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AxolotlBucketLabs\\DevTools\\": "src/"
        },
        "files": [
            "src/Build/php-parser-bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AxolotlBucketLabs\\DevTools\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "extra": {
        "devtools": {
            "release-version": "4.0.2"
        }
    },
    "support": {
        "issues": "https://github.com/AxolotlBucketLabs/DevTools/issues",
        "source": "https://github.com/AxolotlBucketLabs/DevTools"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "artifact": "@php bin/validate-artifact.php build/DevTools.phar",
        "build": "@php -d phar.readonly=0 bin/devtools-build.php --overwrite",
        "build:self": "@build",
        "docs": "@php bin/check-doc-links.php",
        "ecosystem": "@php bin/check-ecosystem.php",
        "check": [
            "composer validate --strict",
            "@syntax",
            "@yamllint",
            "@lint",
            "@phpstan",
            "@test",
            "@docs",
            "@ecosystem",
            "@build",
            "@artifact"
        ],
        "test": "@php -d phar.readonly=0 vendor/bin/phpunit --colors=always",
        "test:loader": "@php -d phar.readonly=0 vendor/bin/phpunit --testsuite loader --colors=always",
        "test:virion": "@php -d phar.readonly=0 vendor/bin/phpunit --testsuite virion --colors=always",
        "test:build": "@php -d phar.readonly=0 vendor/bin/phpunit --testsuite build --colors=always",
        "analyse": "@phpstan",
        "phpstan": "@php vendor/bin/phpstan analyse --no-progress",
        "yamllint": "@php bin/check-yaml.php",
        "lint": "@php vendor/bin/php-cs-fixer check --diff --verbose",
        "qa": "@check",
        "syntax": "@php bin/check-syntax.php"
    }
}
